-- // Accessory (defaultAccessory)1 - Segue Clone (R15 + R6) + Volta pro Chão
-- Execute no Real Executor

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local accessory = nil
local currentClone = nil

local UNDERGROUND_OFFSET = CFrame.new(0, -15, 0)

local function prepareAccessory(acc)
    if not acc or not acc:FindFirstChild("Handle") then return end
    local handle = acc.Handle
    
    handle:BreakJoints()
    for _, v in ipairs(handle:GetChildren()) do
        if v:IsA("Motor6D") or v:IsA("Weld") or v:IsA("WeldConstraint") or 
           v:IsA("AlignPosition") or v:IsA("AlignOrientation") then
            v:Destroy()
        end
    end
    
    handle.CanCollide = false
    handle.Anchored = true
    handle.Transparency = 0
end

local function findAccessory()
    local char = player.Character
    if not char then return end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") and v.Name == "Accessory (defaultAccessory)1" then
            accessory = v
            prepareAccessory(v)
            return
        end
    end
end

-- Detecção Melhorada para R15 e R6
local function getCloneTorso(clone)
    if not clone then return nil end
    return clone:FindFirstChild("Torso") or clone:FindFirstChild("UpperTorso")
end

local function isClone(model)
    if not model or not model:IsA("Model") then return false end
    if not getCloneTorso(model) then return false end
    
    -- Detecção forte
    if model.Name:find("%(%d+%)") or model.Name:find("Clone") or model.Name:find("clone") then
        return true
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == model.Name and model ~= plr.Character then
            return true
        end
    end
    return false
end

local function makeCloneInvisible(clone)
    if not clone then return end
    for _, part in ipairs(clone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
            part.CanCollide = false
        end
    end
end

local function goToGround()
    if accessory and accessory:FindFirstChild("Handle") then
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            accessory.Handle.CFrame = root.CFrame * UNDERGROUND_OFFSET
        end
    end
end

local function update()
    if not accessory or not accessory:FindFirstChild("Handle") then return end
    
    local torso = currentClone and getCloneTorso(currentClone)
    
    if currentClone and currentClone.Parent and torso then
        accessory.Handle.CFrame = torso.CFrame * CFrame.new(0, 0, 0)
        makeCloneInvisible(currentClone)
    else
        goToGround()
    end
end

local function onChildAdded(child)
    if isClone(child) then
        task.wait(0.1)
        currentClone = child
    end
end

-- Inicialização
local function init()
    findAccessory()
    goToGround()
end

init()

player.CharacterAdded:Connect(function()
    task.wait(2)
    findAccessory()
    goToGround()
end)

Workspace.ChildAdded:Connect(onChildAdded)
RunService.Heartbeat:Connect(update)

-- Segurança + Scan contínuo
task.spawn(function()
    while true do
        task.wait(0.3)
        if currentClone and not currentClone.Parent then
            currentClone = nil
        end
        
        -- Scan manual extra
        if not currentClone then
            for _, obj in ipairs(Workspace:GetChildren()) do
                if isClone(obj) then
                    currentClone = obj
                    break
                end
            end
        end
        
        if accessory and accessory:FindFirstChild("Handle") and not currentClone then
            goToGround()
        end
    end
end)

--// LMS Auto Effects Script
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local button = player.PlayerGui:WaitForChild("HacklordUI"):WaitForChild("TextButton")

local effect1 = workspace:WaitForChild("GelatekReanimate", 5)
    :WaitForChild("Head")
    :WaitForChild("EyesFlare")
    :WaitForChild("Small :D")

local effect2 = workspace.GelatekReanimate.Head.EyesFlare:WaitForChild("Flames")

local isWaiting = false
local currentDelayThread = nil

local function enableEffects()
    if effect1 and effect2 then
        effect1.Enabled = true
        effect2.Enabled = true
    end
end

local function disableEffects()
    if effect1 and effect2 then
        effect1.Enabled = false
        effect2.Enabled = false
    end
end

-- Loop principal
RunService.Heartbeat:Connect(function()
    if not button then return end
    
    local text = button.Text:upper():gsub("%s+", " ")
    
    if text == "LMS ON" then
        if not isWaiting then
            isWaiting = true
            
            currentDelayThread = task.spawn(function()
                local startTime = tick()
                
                while tick() - startTime < 22 do
                    if button.Text:upper():gsub("%s+", " ") ~= "LMS ON" then
                        isWaiting = false
                        currentDelayThread = nil
                        return
                    end
                    task.wait()
                end
                
                enableEffects()
                isWaiting = false
                currentDelayThread = nil
            end)
        end
        
    elseif text == "LMS OFF" then
        if isWaiting and currentDelayThread then
            task.cancel(currentDelayThread)
            currentDelayThread = nil
        end
        isWaiting = false
        disableEffects()
    end
end)

