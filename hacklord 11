local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local hacklord = nil
local alignData = nil
local visualBlock = nil

local FOLLOW_DISTANCE = 5        
local ROTATION_SPEED = 9       -- Velocidade de órbita como você pediu

local angleX = 0
local angleY = 0
local angleZ = 0

local function getCharacter()
    return player.Character or player.CharacterAdded:Wait()
end

local function createVisualBlock()
    if visualBlock then visualBlock:Destroy() end
    
    visualBlock = Instance.new("Part")
    visualBlock.Name = "AlignVisual"
    visualBlock.Size = Vector3.new(1, 1, 1)
    visualBlock.Transparency = 0.7
    visualBlock.Anchored = true
    visualBlock.CanCollide = false
    visualBlock.BrickColor = BrickColor.new("Medium stone grey")
    visualBlock.Material = Enum.Material.SmoothPlastic
    visualBlock.Parent = Workspace
end

local function removeDuplicates()
    local char = getCharacter()
    if not char then return end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") and v.Name == "Accessory (ElrkingShedDominonAccessory)" then
            if hacklord and hacklord ~= v then
                v:Destroy()
            else
                hacklord = v
            end
        end
    end
end

local function prepareHacklord()
    removeDuplicates()
    
    local char = getCharacter()
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") and v.Name == "Accessory (ElrkingShedDominonAccessory)" and v:FindFirstChild("Handle") then
            hacklord = v
            break
        end
    end
    
    if not hacklord then return end
    
    local handle = hacklord.Handle
    handle:BreakJoints()
    
    for _, v in ipairs(handle:GetChildren()) do
        if v:IsA("Motor6D") or v:IsA("Weld") or v:IsA("WeldConstraint") or 
           v:IsA("AlignPosition") or v:IsA("AlignOrientation") then
            v:Destroy()
        end
    end
    
    handle.CanCollide = false
    handle.Anchored = false
    handle.Transparency = 0
    
    local att0 = handle:FindFirstChild("Attachment") or Instance.new("Attachment", handle)
    local att1 = Instance.new("Attachment")
    att1.Parent = Workspace.Terrain
    
    local alignPos = Instance.new("AlignPosition")
    alignPos.Attachment0 = att0
    alignPos.Attachment1 = att1
    alignPos.MaxForce = 80000
    alignPos.Responsiveness = 22
    alignPos.Parent = handle
    
    local alignOri = Instance.new("AlignOrientation")
    alignOri.Attachment0 = att0
    alignOri.Attachment1 = att1
    alignOri.MaxTorque = 40000
    alignOri.Responsiveness = 18
    alignOri.Parent = handle
    
    alignData = {att1 = att1}
    
    createVisualBlock()
end

local function updateFollow()
    if not hacklord or not hacklord:FindFirstChild("Handle") or not alignData then return end
    local root = getCharacter():FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    angleX = angleX + ROTATION_SPEED * 0.6
    angleY = angleY + ROTATION_SPEED * 1.4
    angleZ = angleZ + ROTATION_SPEED * 0.8
    
    local targetPos = root.CFrame * CFrame.new(0, 2, -FOLLOW_DISTANCE)
    
    local selfRotation = CFrame.Angles(angleX, angleY, angleZ)
    
    local targetCFrame = targetPos * selfRotation
    
    alignData.att1.WorldCFrame = targetCFrame
    
    if visualBlock then
        visualBlock.CFrame = targetCFrame
    end
end

local function init()
    prepareHacklord()
end

